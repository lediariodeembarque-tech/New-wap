  "properties": {
    "modo": {
      "type": "string",
      "enum": [
        "automatico",
        "claro",
        "escuro"
      ],
      "default": "automatico"
    },
    "cor": {
      "type": "string"
    },
    "imagem_url": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}